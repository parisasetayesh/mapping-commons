---
import type { CollectionEntry } from 'astro:content';
import { statusLabels, domains, pathwayLessonHref } from '../lib/content';
interface Props { pathway: CollectionEntry<'pathways'>; lessonById: Map<string, CollectionEntry<'lessons'>>; }
const {pathway, lessonById}=Astro.props;
---
<ol class="pathway-sequence" tabindex="0" aria-label={`${pathway.data.title}: lessons in order`}>
  {pathway.data.steps.map((step,i)=>{const lesson=lessonById.get(step.lesson)!;return <li>
    <a class="pathway-square" data-domain={lesson.data.primary_category} href={pathwayLessonHref(pathway.id,lesson.id)}>
      <span class="pathway-square-top"><span class="step-number">{String(i+1).padStart(2,'0')}</span><span>{step.required?'Required':'Optional'}</span></span>
      <span class="pathway-square-title">{lesson.data.title}</span>
      <span class="pathway-square-status">{statusLabels[lesson.data.status]} · {lesson.data.duration_minutes} min</span>
      <span class="sr-only">{domains[lesson.data.primary_category]}</span>
    </a>
  </li>;})}
</ol>
